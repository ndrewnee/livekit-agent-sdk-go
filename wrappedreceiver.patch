 func NewWrappedReceiver(params WrappedReceiverParams) *WrappedReceiver {
@@ -130,15 +131,62 @@
 
 	onReadyCallbacks := r.onReadyCallbacks
 	r.onReadyCallbacks = nil
+
+	// Process any pending downtracks that were queued before receiver was ready
+	pendingDownTracks := r.pendingDownTracks
+	r.pendingDownTracks = nil
 	r.lock.Unlock()
 
 	for _, f := range onReadyCallbacks {
 		trackReceiver.AddOnReady(f)
 	}
 
+	// Add all pending downtracks now that receiver is ready
+	for _, dt := range pendingDownTracks {
+		r.params.Logger.Infow("[DEBUG WrappedReceiver] Adding queued downtrack",
+			"subscriberID", dt.SubscriberID(),
+			"trackID", r.params.TrackID,
+		)
+		if err := trackReceiver.AddDownTrack(dt); err != nil {
+			r.params.Logger.Errorw("failed to add queued downtrack", err,
+				"subscriberID", dt.SubscriberID(),
+				"trackID", r.params.TrackID,
+			)
+		}
+	}
+
 	return
 }
 
+func (r *WrappedReceiver) AddDownTrack(track sfu.TrackSender) error {
+	r.lock.Lock()
+	defer r.lock.Unlock()
+
+	receiverNil := r.TrackReceiver == nil
+	r.params.Logger.Infow("[DEBUG WrappedReceiver] AddDownTrack called",
+		"subscriberID", track.SubscriberID(),
+		"trackID", r.params.TrackID,
+		"receiverIsNil", receiverNil,
+	)
+
+	if r.TrackReceiver != nil {
+		// Receiver is ready, add downtrack directly
+		r.params.Logger.Infow("[DEBUG WrappedReceiver] Receiver ready, adding downtrack directly",
+			"subscriberID", track.SubscriberID(),
+			"trackID", r.params.TrackID,
+		)
+		return r.TrackReceiver.AddDownTrack(track)
+	}
+
+	// Receiver not ready yet, queue the downtrack
+	r.params.Logger.Infow("[DEBUG WrappedReceiver] Queuing downtrack until receiver is ready",
+		"subscriberID", track.SubscriberID(),
+		"trackID", r.params.TrackID,
+	)
+	r.pendingDownTracks = append(r.pendingDownTracks, track)
+	return nil
+}
+
 func (r *WrappedReceiver) Codecs() []webrtc.RTPCodecParameters {
 	return slices.Clone(r.codecs)
 }
